<?xml version="1.0" encoding="ISO-8859-1"?>

<alg_conf>

<!--
Configuration for the MAID2007 RES excitation xsec fast integrator.

This integrator uses the same W,Q2 area transformation as the fast RES
integrator, but its local cache is MAID-specific. It does not inherit the
Rein-Sehgal all-resonance cache warmup or the hard minimum ESplineMax.
MAID W-support and Breit-Wigner conventions remain controlled by the
MAIDRESPXSec configuration.

Algorithm Configurable Parameters:
...........................................................................................................
Name                        Type    Opt  Comment                                               Default
...........................................................................................................
ResonanceNameList           string  No   list of MAID resonances                               CommonParam[MAID2007Resonances]
UsePauliBlockingForRES      bool    Yes  use Pauli blocking? disables local cache if true      false
UseCache                    bool    Yes  use local free-nucleon excitation cache               false
CacheAllResonances          bool    Yes  warm all configured resonances on cache miss          false
CacheEMin                   double  Yes  minimum energy in local cache splines                 0.01
ESplineMax                  double  Yes  maximum energy in local cache splines                 20
CacheNKnots                 int     Yes  number of local cache-spline knots                    50
gsl-integration-type        string  Yes  name of GSL numerical integrator                      adaptive
gsl-max-eval                int     Yes  GSL number of function calls                          100000
gsl-relative-tolerance      double  Yes  relative tolerance of integration                     0.01
-->

  <param_set name="Default">
    <param type="string" name="CommonParam"> MAID2007Resonances </param>
    <param type="bool"   name="UsePauliBlockingForRES"> false </param>
    <param type="bool"   name="UseCache"> false </param>
    <param type="bool"   name="CacheAllResonances"> false </param>
    <param type="double" name="CacheEMin"> 0.01 </param>
    <param type="double" name="ESplineMax"> 20.0 </param>
    <param type="int"    name="CacheNKnots"> 50 </param>
    <param type="string" name="gsl-integration-type"> adaptive </param>
    <param type="int"    name="gsl-max-eval"> 100000 </param>
    <param type="double" name="gsl-relative-tolerance"> 0.01 </param>
  </param_set>

  <param_set name="NoPauliBlock-MAID2007">
    <param type="string" name="CommonParam"> MAID2007Resonances </param>
    <param type="bool"   name="UsePauliBlockingForRES"> false </param>
  </param_set>

</alg_conf>
